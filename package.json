{
  "name": "better-effect-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docs:dev": "turbo run dev --filter=@better-effect/docs",
    "docs:build": "turbo run build --filter=@better-effect/docs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:containers": "bun test scripts/mq-container-support.test.ts && bun scripts/test-mq-containers.ts",
    "lint": "turbo run lint && bun run lint:release",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "publint": "turbo run publint --filter=better-effect --filter=better-effect-mq --filter=better-effect-better-auth --filter=better-effect-kysely --filter=better-effect-zod --filter=better-effect-mq-postgres --filter=better-effect-mq-redis --filter=better-effect-mq-mongodb --filter=better-effect-mq-sqlite --filter=better-effect-mq-mysql",
    "lint:release": "packages/better-effect/node_modules/.bin/oxlint --type-aware scripts/check-kysely-docs.ts scripts/release-artifact.ts scripts/release-plan.ts scripts/release-route.ts scripts/release-route.test.ts",
    "check": "turbo run check --concurrency=1 && bun run test:kysely-docs && bun run test:release && bun run lint:release",
    "test:kysely-docs": "bun scripts/check-kysely-docs.ts",
    "release:plan": "bun scripts/release-plan.ts",
    "test:release": "bun test scripts/release-route.test.ts",
    "perf:type-system": "bun scripts/type-system-performance.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/mysql": "^12.1.0",
    "lefthook": "^2.1.10",
    "mongodb": "^6.21.0",
    "oxfmt": "^0.63.0",
    "oxlint-tsgolint": "^7.0.2001",
    "testcontainers": "^12.1.0",
    "turbo": "^2.10.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "warn"
    }
  },
  "packageManager": "bun@1.3.14"
}
