{
  "name": "better-effect-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docs:dev": "turbo run dev --filter=@better-effect/docs",
    "docs:build": "turbo run build --filter=@better-effect/docs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "publint": "turbo run publint --filter=better-effect",
    "check": "turbo run check"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "turbo": "^2.10.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  }
}
