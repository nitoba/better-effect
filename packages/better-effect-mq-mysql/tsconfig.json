{
  "compilerOptions": {
    "lib": ["ESNext", "ES2023", "ESNext.Disposable"],
    "target": "ESNext",
    "module": "ESNext",
    "types": ["bun", "node"],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src", "tests"],
  "exclude": ["tests/package/consumer"]
}
