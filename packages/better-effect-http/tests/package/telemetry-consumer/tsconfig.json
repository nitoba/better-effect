{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "noEmit": false,
    "types": [],
    "outDir": "out"
  },
  "include": ["src/index.ts"]
}
