{
  "name": "better-effect-http",
  "version": "0.1.0",
  "description": "Layer-first HTTP client foundations for better-effect.",
  "keywords": [
    "better-effect",
    "better-result",
    "fetch",
    "http",
    "typescript"
  ],
  "homepage": "https://github.com/nitoba/better-effect#readme",
  "bugs": {
    "url": "https://github.com/nitoba/better-effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/better-effect.git",
    "directory": "packages/better-effect-http"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "VERIFICATION.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./endpoints": "./dist/endpoints.mjs",
    "./opentelemetry": "./dist/opentelemetry.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && bun run build && bun run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "test:types": "tsc -p tests/types/tsconfig.json --pretty false",
    "test": "bun test",
    "test:package-boundaries": "bun tests/package/boundaries.ts",
    "test:package-consumer": "bun tests/package/external-consumer.ts",
    "examples:run": "bun examples/typed-client.ts && bun examples/auth-retry.ts && bun examples/endpoints-sdk.ts && bun examples/download.ts && bun examples/ndjson.ts && bun examples/sse-progress.ts && bun examples/sse-resumable.ts && bun examples/generation.ts && bun examples/hono-streaming.ts",
    "test:docs": "bun ../../scripts/check-http-docs.ts",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "check": "bun run typecheck && bun run test:types && bun test && bun run format:check && bun run build && bun run examples:run && bun run test:docs && bun run test:package-boundaries && bun run test:package-consumer && bun run publint && bun run release:dry && bun run lint",
    "prepublishOnly": "bun run check",
    "release:dry": "bun ../../scripts/release-artifact.ts --package better-effect-http"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.6",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@types/bun": "1.4.1",
    "@types/node": "26.1.2",
    "arktype": "2.2.3",
    "better-effect": "0.14.0",
    "better-effect-schema": "0.1.0",
    "better-result": "^3.0.0",
    "hono": "4.13.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "valibot": "1.4.2",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <1.10.0",
    "better-effect": ">=0.13.0 <0.14.0",
    "better-effect-schema": ">=0.1.0 <0.2.0",
    "better-result": "^3.0.0",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
