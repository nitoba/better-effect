{
  "name": "better-effect-schema",
  "version": "0.1.2",
  "description": "Schema primitives and classes with better-result failures and better-effect composition.",
  "keywords": [
    "better-effect",
    "better-result",
    "class",
    "codec",
    "effect",
    "schema",
    "standard-schema",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/nitoba/better-effect#readme",
  "bugs": {
    "url": "https://github.com/nitoba/better-effect/issues"
  },
  "license": "MIT",
  "author": "Bruno Alves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/better-effect.git",
    "directory": "packages/better-effect-schema"
  },
  "files": [
    "dist",
    "docs/api.md",
    "docs/valibot.md",
    "docs/arktype.md",
    "docs/zod.md",
    "docs/architecture.md",
    "README.md",
    "VERIFICATION.md",
    "MIGRATION.md",
    "MONOREPO_INTEGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./zod": {
      "types": "./dist/esm/zod.d.ts",
      "import": "./dist/esm/zod.js",
      "default": "./dist/esm/zod.js"
    },
    "./valibot": {
      "types": "./dist/esm/valibot.d.ts",
      "import": "./dist/esm/valibot.js",
      "default": "./dist/esm/valibot.js"
    },
    "./arktype": {
      "types": "./dist/esm/arktype.d.ts",
      "import": "./dist/esm/arktype.js",
      "default": "./dist/esm/arktype.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "bun ./scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun ./scripts/build.mjs",
    "test:runtime": "bun ./scripts/test-runtime.mjs",
    "test:conformance": "bun test tests/conformance/*.test.ts",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "test": "bun run clean && bun run build && bun run test:runtime && bun run test:conformance && bun run test:types",
    "examples:build": "tsc -p tsconfig.examples.json",
    "examples:run": "bun ./scripts/run-examples.mjs",
    "examples": "bun run build && bun run examples:build && bun run examples:run",
    "check:source": "bun ./scripts/check-source.mjs",
    "check:package": "bun ./scripts/check-package.mjs",
    "publint": "publint",
    "check": "bun run typecheck && bun run test && bun run examples:build && bun run examples:run && bun run check:source && bun run check:package && bun run test:package && bun run publint && bun run release:dry && npm pack --dry-run --ignore-scripts",
    "prepack": "bun run clean && bun run build",
    "test:package": "bun ./scripts/test-package.mjs",
    "test:package-consumer": "bun ./scripts/test-package.mjs",
    "release:dry": "bun ../../scripts/release-artifact.ts --package better-effect-schema"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "arktype": "2.2.3",
    "better-effect": "0.14.0",
    "better-effect-mq": "0.1.3",
    "better-result": "3.0.1",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "valibot": "1.4.2",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "arktype": ">=2.2.3 <3.0.0",
    "better-effect": ">=0.14.0 <0.15.0",
    "better-result": "^3.0.0",
    "typescript": ">=6.0.0",
    "valibot": ">=1.4.2 <2",
    "zod": ">=4.5.4 <5"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
