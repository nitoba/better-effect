{
  "name": "better-effect-better-auth",
  "version": "0.1.0",
  "description": "Effect-like server integration between Better Auth and better-effect.",
  "keywords": [
    "auth",
    "better-auth",
    "better-effect",
    "better-result",
    "typescript"
  ],
  "homepage": "https://github.com/nitoba/better-effect#readme",
  "bugs": {
    "url": "https://github.com/nitoba/better-effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/better-effect.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./hooks": "./dist/hooks.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && bun run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test:types:minimum": "bunx --bun --package typescript@5.7.2 tsc -p tests/types/tsconfig.json && bunx --bun --package typescript@5.7.2 tsc -p examples/tsconfig.json",
    "test:public-types": "tsc -p tests/package/public-types/tsconfig.json",
    "test:public-types:minimum": "bunx --bun --package typescript@5.7.2 tsc -p tests/package/public-types/tsconfig.json",
    "test:public-types:invalid": "bun tests/package/public-types/check-invalid.ts",
    "test:types:performance": "cd ../.. && bun scripts/type-system-performance.ts --scenarios=better-auth --check-budget",
    "test": "bun test",
    "test:package-boundaries": "bun tests/package/boundaries.ts",
    "test:package-consumer": "bun tests/package/external-consumer.ts",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "check": "bun run typecheck && bun run test:types && bun run test:types:minimum && bun test && bun run format:check && bun run build && bun run test:public-types && bun run test:public-types:minimum && bun run test:public-types:invalid && bun run test:types:performance && bun run test:package-boundaries && bun run test:package-consumer && bun run publint && bun run release:dry && bun run lint",
    "prepublishOnly": "bun run check",
    "release:dry": "bun ../../scripts/release-artifact.ts --package better-effect-better-auth"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "better-auth": "^1.7.2",
    "better-effect": "workspace:*",
    "better-result": "^3.0.0",
    "hono": "^4.9.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0",
    "better-effect": ">=0.12.0 <0.14.0",
    "better-result": "^3.0.0",
    "typescript": ">=5.7.0"
  }
}
