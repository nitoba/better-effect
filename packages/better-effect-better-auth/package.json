{
  "name": "better-effect-better-auth",
  "version": "0.1.0",
  "description": "Typed Better Auth server error and package foundations for better-effect.",
  "keywords": [
    "auth",
    "better-auth",
    "better-effect",
    "better-result",
    "typescript"
  ],
  "homepage": "https://github.com/nitoba/better-effect#readme",
  "bugs": {
    "url": "https://github.com/nitoba/better-effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/better-effect.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test:types:minimum": "bunx --bun --package typescript@5.7.2 tsc -p tests/types/tsconfig.json",
    "test": "bun test",
    "test:package-boundaries": "bun tests/package/boundaries.ts",
    "test:package-consumer": "bun tests/package/external-consumer.ts",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "check": "bun run typecheck && bun run test:types && bun run test:types:minimum && bun test && bun run format:check && bun run build && bun run test:package-boundaries && bun run test:package-consumer && bun run publint && bun run lint",
    "prepublishOnly": "bun run check",
    "release:dry": "bun publish --dry-run"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "better-auth": "^1.7.2",
    "better-effect": "workspace:*",
    "better-result": "^3.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0",
    "better-effect": "^0.12.0",
    "better-result": "^3.0.0",
    "typescript": ">=5.7.0"
  }
}
