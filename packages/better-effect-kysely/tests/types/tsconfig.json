{
  "compilerOptions": {
    "lib": ["ES2022", "ESNext.Disposable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "files": [
    "foundation.types.ts",
    "operation.types.ts",
    "transaction.types.ts",
    "dialect.types.ts",
    "factories.types.ts"
  ]
}
