{
  "name": "better-effect-mq-redis",
  "version": "0.1.0",
  "description": "Redis and Valkey foundation adapter for better-effect-mq.",
  "keywords": [
    "better-effect",
    "better-result",
    "message-queue",
    "redis",
    "typescript",
    "valkey"
  ],
  "homepage": "https://github.com/nitoba/better-effect#readme",
  "bugs": {
    "url": "https://github.com/nitoba/better-effect/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/better-effect.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && bun scripts/sanitize-sourcemaps.ts && rm -rf dist/scripts && cp -R src/scripts dist/scripts",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:package-boundaries": "bun tests/package/boundaries.ts",
    "test:package-consumer": "bun tests/package/external-consumer.ts",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publint": "publint",
    "check": "bun run typecheck && bun test && bun run format:check && bun run build && bun run test:package-boundaries && bun run test:package-consumer && bun run publint && bun run release:dry && bun run lint",
    "prepublishOnly": "bun run check",
    "release:dry": "bun ../../scripts/release-artifact.ts --package better-effect-mq-redis"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@types/node": "^22.0.0",
    "better-effect": "0.13.0",
    "better-effect-mq": "0.1.0",
    "better-result": "^3.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "redis": "^5.8.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "better-effect": ">=0.13.0 <0.14.0",
    "better-effect-mq": ">=0.1.0 <0.2.0",
    "better-result": "^3.0.0",
    "redis": ">=4.6.0 <6.0.0",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  }
}
